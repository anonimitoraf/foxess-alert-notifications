# ---------------------------------------------------------------------------
# foxess-alert-notifications - copy to .env and fill in the blanks.
# ---------------------------------------------------------------------------

# --- Required: FoxESS Cloud account --------------------------------------
# The same credentials you use on https://www.foxesscloud.com
FOXESS_USERNAME=you@example.com
FOXESS_PASSWORD=your-password

# --- Required: outbound email --------------------------------------------
MAIL_TO=alerts@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASS=your-smtp-password

# STARTTLS on 587 (default) or implicit TLS on 465. When SMTP_PORT=465 the
# transport switches to TLS automatically; override with SMTP_SECURE.
# SMTP_SECURE=false
# SMTP_REQUIRE_TLS=true
# SMTP_REJECT_UNAUTHORIZED=true

# Sender address. Defaults to SMTP_USER.
# MAIL_FROM="FoxESS Alerts <alerts@example.com>"
# MAIL_CC=second@example.com,third@example.com
# MAIL_SUBJECT_PREFIX=[FoxESS]

# --- Optional: how to talk to FoxESS -------------------------------------
# api     = plain HTTPS calls to the same endpoints the web app uses (default)
# browser = drive the real site with headless Chromium (fallback; needs the
#           image built with --build-arg WITH_BROWSER=true)
# FOXESS_MODE=api
#
# FOXESS_BASE_URL=https://www.foxesscloud.com
# FOXESS_LANG=en

# --- Optional: what counts as an alert -----------------------------------
# active  = faults that are happening right now
# history = faults that occurred within ALERT_LOOKBACK_HOURS (includes recovered)
# both    = union of the two (default); duplicates collapse automatically
# FOXESS_ALERT_SCOPE=both
#
# ALERT_LOOKBACK_HOURS=24      history window (0 = no limit)
# ALERT_MIN_SEVERITY=unknown   critical | warning | info | unknown
# FOXESS_PLANT_IDS=            only check these plants (comma separated id or name)
# FOXESS_HISTORY_CHUNK_DAYS=14 history is fetched in <=14 day windows (API limit)

# --- Optional: when to check ---------------------------------------------
# POLL_INTERVAL_MINUTES=30
# POLL_JITTER_SECONDS=30
# RUN_ONCE=false
# MAX_ATTEMPTS=3
# RETRY_BACKOFF_MS=5000
# API_TIMEOUT_MS=30000

# --- Optional: notification policy ---------------------------------------
# NOTIFY_MODE=new              new = only unseen alerts, all = every alert on every run
# NOTIFY_ON_FIRST_RUN=true     email the current backlog on the very first run
# NOTIFY_ON_EMPTY=false        send an "all clear" email when nothing is wrong
# NOTIFY_ON_ERROR=true         email when the check itself fails
# ALERT_SIGNAL_FALLBACK=true   (browser mode) report an unread badge count when no rows scraped
# ERROR_NOTIFY_COOLDOWN_HOURS=6
# MAX_ALERTS_PER_EMAIL=50
# STATE_RETENTION_DAYS=30

# --- Optional: runtime ----------------------------------------------------
# LOG_LEVEL=info               debug | info | warn | error | silent
# HEALTH_PORT=8080             0 disables the health endpoint
# TZ=Australia/Melbourne       used when a plant does not report its own zone
# FOXESS_TIMEZONE=Australia/Melbourne
# STATE_FILE=/data/state.json
# SESSION_FILE=/data/session.json
# DRY_RUN=false

# --- Troubleshooting ------------------------------------------------------
# See the email without sending anything:
#   DRY_RUN=true
#
# Dump the request/response detail:
#   LOG_LEVEL=debug
#
# Use a token captured from the browser instead of logging in (expires quickly):
#   FOXESS_TOKEN=biz-web-....-....-....-....
#
# Signature header: the server currently ignores it, but we send a real one,
# generated by the site's own WASM module (cached in /data/signer).
# Set FOXESS_SIGNATURE=off to skip the download (e.g. no internet at boot).
#
# Browser mode only (FOXESS_MODE=browser):
# HEADLESS=true
# FOXESS_ALERTS_ROUTES=/bus/alarm
# FOXESS_LOGIN_ROUTE=/login
# DEBUG=true
# DEBUG_DIR=./debug
# FOXESS_PAGE_ACTIONS=[{"goto":"/bus/alarm"},{"click":".el-button--primary"},{"wait":3000}]

{
  "name": "foxess-alert-notifications",
  "version": "1.0.0",
  "private": true,
  "description": "Checks a FoxESS Cloud account for alerts over the HTTP API (no browser) and emails them to a configured recipient.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "check": "node src/index.js --once",
    "debug": "node src/index.js --once --debug --dry-run",
    "browser:e2e": "FOXESS_MODE=browser node --test test/browser.e2e.test.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "nodemailer": "^10.2.1"
  },
  "optionalDependencies": {
    "playwright": "^1.64.1"
  }
}
